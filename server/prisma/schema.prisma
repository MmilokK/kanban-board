generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BoardMemberRole {
  OWNER
  EDITOR
  VIEWER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskHistoryEventType {
  TASK_CREATED
  TASK_UPDATED
  TASK_MOVED
  TASK_ARCHIVED
  TASK_RESTORED

  SUBTASK_ADDED
  SUBTASK_UPDATED
  SUBTASK_COMPLETED
  SUBTASK_REOPENED
  SUBTASK_DELETED

  COMMENT_ADDED
  COMMENT_UPDATED
  COMMENT_DELETED
}

enum BoardInvitationType {
  EMAIL
  LINK
}

model PasswordCredential {
  userId String @id

  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

model Session {
  id String @id @default(uuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model User {
  id    String  @id @default(uuid())
  email String  @unique
  name  String?

  passwordCredential PasswordCredential?
  sessions           Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          BoardMember[]
  sentBoardInvitations BoardInvitation[]
  comments             Comment[]
  historyEvents        TaskHistoryEvent[]

  @@map("users")
}

model Board {
  id    String @id @default(uuid())
  title String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     BoardMember[]
  invitations BoardInvitation[]
  columns     Column[]

  @@map("boards")
}

model BoardMember {
  id String @id @default(uuid())

  boardId String
  userId  String

  role BoardMemberRole @default(VIEWER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
  @@index([userId])
  @@index([boardId])
  @@map("board_members")
}

model BoardInvitation {
  id              String              @id @default(uuid())
  boardId         String
  invitedByUserId String
  type            BoardInvitationType
  email           String?
  role            BoardMemberRole
  token           String              @unique
  expiresAt       DateTime
  maxUses         Int?
  usedCount       Int                 @default(0)
  revokedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  board         Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  invitedByUser User  @relation(fields: [invitedByUserId], references: [id], onDelete: Cascade)

  @@index([boardId])
  @@index([email])
  @@index([expiresAt])
}

model Column {
  id String @id @default(uuid())

  boardId String

  title String

  position Int

  isCompleted Boolean @default(false)
  isArchive   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([boardId, position])
  @@index([boardId])
  @@map("columns")
}

model Task {
  id String @id @default(uuid())

  columnId String

  title       String
  description String @default("")

  priority TaskPriority @default(MEDIUM)

  tags String[] @default([])

  dueDate DateTime?

  archivedAt DateTime?

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  column Column @relation(fields: [columnId], references: [id], onDelete: Cascade)

  subtasks      Subtask[]
  comments      Comment[]
  historyEvents TaskHistoryEvent[]

  @@unique([columnId, position])
  @@index([columnId])
  @@index([dueDate])
  @@index([archivedAt])
  @@map("tasks")
}

model Subtask {
  id String @id @default(uuid())

  taskId String

  title       String
  description String @default("")

  isCompleted Boolean @default(false)

  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
  @@index([taskId])
  @@map("subtasks")
}

model Comment {
  id String @id @default(uuid())

  taskId   String
  authorId String?

  text String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([authorId])
  @@map("comments")
}

model TaskHistoryEvent {
  id String @id @default(uuid())

  taskId  String
  actorId String?

  type TaskHistoryEventType

  payload Json?

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([actorId])
  @@index([createdAt])
  @@map("task_history_events")
}
